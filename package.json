{
  "name": "plumelens",
  "version": "0.7.8",
  "description": "鉴翎 - 辅助鸟类摄影爱好者快速筛选鸟类照片",
  "main": "./out/main/index.js",
  "author": "wlfcss",
  "type": "module",
  "license": "GPL-3.0",
  "scripts": {
    "start": "npm run ensure:electron && electron-vite dev",
    "ensure:electron": "npx install-electron --no",
    "build:engine": "node scripts/build-engine.cjs",
    "species:artwork:download": "uv run --project engine python scripts/download_species_artwork.py",
    "species:artwork:optimize": "uv run --project engine python scripts/optimize_species_artwork.py",
    "species:artwork:attribution": "uv run --project engine python scripts/generate_species_artwork_attributions.py",
    "species:artwork": "npm run species:artwork:download && npm run species:artwork:optimize && npm run species:artwork:attribution",
    "build": "electron-vite build",
    "dist:win": "npm run build && electron-builder --win --x64",
    "build:dmg-background": "uv run python scripts/build_dmg_background.py",
    "dist:mac:bundle": "npm run build:dmg-background && npm run build && npx electron-builder --mac --arm64",
    "dist:mac:smoke": "uv run --no-sync --project engine python tests/e2e-electron/fixtures/generate_photos.py && npx playwright test --config=tests/e2e-electron/playwright.config.ts cold-start.spec.ts",
    "dist:mac": "npm run dist:mac:bundle && npm run dist:mac:smoke",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --build --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:packaged": "uv run --no-sync --project engine python tests/e2e-electron/fixtures/generate_photos.py && npx playwright test --config=tests/e2e-electron/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-virtual": "^3.14.28",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "electron": "45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "i18next": "^26.7.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^1.79.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "resedit": "^1.7.2",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^4.1.12",
    "zustand": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "echarts": "^6.1.0",
    "pinyin-pro": "^3.29.5"
  }
}
